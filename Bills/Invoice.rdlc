                              <TextRuns>
                                <TextRun>
                                  <Value>=CDbl(IIf(
    IsNothing(Fields!amount.Value) OR Fields!amount.Value = "",
    0,
    Fields!amount.Value
))
+
CDbl(IIf(
    IsNothing(Fields!totalAmount.Value) OR Fields!totalAmount.Value = "",
    0,
    Fields!totalAmount.Value
))</Value>
                                  <Style>
